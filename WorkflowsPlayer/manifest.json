{
  "manifest_version": 3,
  "name": "Tour Guiado con Shepherd",
  "version": "1.0",
  "description": "Herramienta de entrenamiento con tours guiados usando Shepherd.js",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.json",
        "libs/shepherd.min.js",
        "styles/shepherd.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "auth/auth.js",
        "auth/supabase-client.js",
        "storage/storage-utils.js",
        "libs/supabase.min.js",
        "libs/shepherd.min.js",
        "content/validation/expected-state.js",
        "content/content.js"
      ],
      "css": [
        "styles/overlay.css",
        "styles/shepherd.css"
      ],
      "run_at": "document_end"
    }
  ]
}